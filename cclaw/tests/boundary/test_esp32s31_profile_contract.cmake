require_profile_line("set(CC_PROFILE_ENABLE_MULTIMODAL ON)")
require_profile_line("set(CC_PROFILE_ENABLE_MEDIA_IMAGE ON)")
require_profile_line("set(CC_PROFILE_ENABLE_INLINE_BASE64 ON)")
