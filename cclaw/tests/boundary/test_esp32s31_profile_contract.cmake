if(NOT DEFINED CCLAW_SOURCE_DIR)
    message(FATAL_ERROR "CCLAW_SOURCE_DIR is required")
endif()

set(profile "${CCLAW_SOURCE_DIR}/profiles/esp32s31-tools.cmake")
if(NOT EXISTS "${profile}")
    message(FATAL_ERROR "Missing esp32s31-tools profile")
endif()

file(READ "${profile}" content)

function(require_profile_line line)
    string(FIND "${content}" "${line}" pos)
    if(pos LESS 0)
        message(FATAL_ERROR "esp32s31-tools profile must contain: ${line}")
    endif()
endfunction()

require_profile_line("set(CC_PROFILE_TARGET_PLATFORM esp32)")
require_profile_line("set(CC_PROFILE_ENABLE_OPENAI ON)")
require_profile_line("set(CC_PROFILE_ENABLE_STREAMING ON)")
require_profile_line("set(CC_PROFILE_ENABLE_FILE_TOOLS ON)")
require_profile_line("set(CC_PROFILE_ENABLE_MEMORY ON)")
